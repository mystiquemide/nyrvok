# KeeperHub API Configuration
KEEPERHUB_API_KEY=kh_your_api_key_here
KEEPERHUB_BASE_URL=https://app.keeperhub.com/api

# Base Network RPC Configuration
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Optional: Wayfinder Coordinator URL.
# When set, the app queries the coordinator's REST API for strategies and
# pathways, falling back to recorded fixtures if it is unreachable. Leave
# unset to run in deterministic fixture mode.
# WAYFINDER_API_BASE_URL=https://your-wayfinder-coordinator.example.com/api/v1

# Optional: default network for the dashboard and ingest API.
# Strategies default to Base Mainnet, which spends real custody funds on
# Execute. Set to base-sepolia for demos and testing.
# DEFAULT_NETWORK=base-sepolia

# Optional: bearer token required on POST /api/waypoint/execute.
# Set this on any deployed instance that holds a live KEEPERHUB_API_KEY so
# unauthenticated internet callers cannot trigger custodial executions.
# Local development does not require it.
# NYRVOK_API_TOKEN=generate-a-long-random-secret

# Optional: override the ERC-8004 reputation registry declared in
# attestation metadata. Defaults to the canonical Base Reputation Registry.
# ERC8004_REGISTRY_ADDRESS=0x8004BAa17C55a88189AE136b182e5fdA19dE9b63
